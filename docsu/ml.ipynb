print(f"Example 1 - Low Standard Deviation:")
print(f"Data: {data_low_std}")
print(f"Mean: {mean_low:.2f}, Std Dev: {std_low:.2f}")
print(f"Data points are close to mean: {mean_low - std_low:.2f} to {mean_low + std_low:.2f}\n")

# High standard deviation example
